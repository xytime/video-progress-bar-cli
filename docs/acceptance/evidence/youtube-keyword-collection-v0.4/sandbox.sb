(version 1)
(allow default)
(deny network*)
(deny mach-lookup)
(deny file-read-data)
(deny file-write*)
(deny signal)
(allow signal (target same-sandbox))
(deny process-info*)
(allow process-info* (target same-sandbox))
(allow file-read-data (subpath "/private/tmp/video-pytest-6x43006w/sandbox"))
(allow file-read-data (subpath "/Volumes/EXT2T/MacMini4_SSD/PycharmProjects/Video-precessing/.venv"))
(allow file-read-data (subpath "/Users/ryusei/.pyenv/versions/3.12.4"))
(allow file-read-data (subpath "/System/Library"))
(allow file-read-data (subpath "/System/Volumes/Preboot/Cryptexes/OS"))
(allow file-read-data (subpath "/usr"))
(allow file-read-data (subpath "/bin"))
(allow file-read-data (subpath "/sbin"))
(allow file-read-data (subpath "/opt/homebrew"))
(allow file-read-data (subpath "/Library/Apple"))
(allow file-read-data (subpath "/Library/Fonts"))
(allow file-read-data (subpath "/Library/Frameworks"))
(allow file-read-data (subpath "/Library/Developer"))
(allow file-read-data (subpath "/private/etc"))
(allow file-read-data (subpath "/private/var/db"))
(allow file-read-data (subpath "/dev"))
(allow file-read-data (literal "/"))
(allow file-write* (subpath "/private/tmp/video-pytest-6x43006w/sandbox") (literal "/dev/null"))
(allow mach-lookup (global-name-regex #"^org\.chromium\.Chromium\.MachPortRendezvousServer\.[0-9]+$"))
