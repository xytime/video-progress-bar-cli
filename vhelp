# 维护子命令仅在用户明确调用时执行；默认 vhelp 只打印手册。
VHELP_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-help}" in
  youtube)
    if (( $# > 2 )); then
      printf '用法: vhelp youtube [help|health|status|start|stop|restart]\n' >&2
      exit 2
    fi
    case "${2:-help}" in
      health) exec "$VHELP_ROOT/.venv/bin/python" "$VHELP_ROOT/scripts/youtube_egress_service.py" health ;;
      status) exec launchctl print "gui/$(id -u)/us.optionbank.video-egress" ;;
      start) exec launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/us.optionbank.video-egress.plist" ;;
      stop) exec launchctl bootout "gui/$(id -u)/us.optionbank.video-egress" ;;
      restart) exec launchctl kickstart -k "gui/$(id -u)/us.optionbank.video-egress" ;;
      help|-h|--help)
        printf '%s\n' 'YouTube 独立自建出口：127.0.0.1:9110' \
          'vhelp youtube health   实际核验 YouTube 自建出口（推荐）' \
          'vhelp youtube status   查看 launchd 状态和 PID，不等同网络可用' \
          'vhelp youtube start    启动已停止的服务' \
          'vhelp youtube restart  重启服务（会中断当前下载）' \
          'vhelp youtube stop     停止并卸载服务（下次登录仍会自动启动）' \
          '登录后自动启动、退出后自动拉起；无需启动猫熊或 Clash Mi。' \
          '先确认后台没有下载，再执行停止或重启；操作后运行 health 验收。'
        exit 0 ;;
      *) printf '未知 YouTube 维护命令；请运行 vhelp youtube help\n' >&2; exit 2 ;;
    esac ;;
  vpn)
    shift
    if [[ "${1:-}" == help ]]; then shift; set -- --help "$@"; fi
    exec "$HOME/.local/bin/vpn-switch" "$@" ;;
  help|-h|--help) ;;
  *) printf '用法: vhelp [help|youtube|vpn]；旧 HY2 统计/导出请用 ~/.local/bin/vhelp <原有子命令>\n' >&2; exit 2 ;;
esac

