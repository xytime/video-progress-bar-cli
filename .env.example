# Video-precessing environment template
# Copy the keys you need into .env and fill real secrets there.

# Core AI providers
GEMINI_API_KEY=

# 标题供应商：默认沿用 Gemini。完成 50 条影子评测并人工确认后，才改为 agy,gemini。
# AGY 只负责平台标题/封面标题/Hook；正文仍由既有文案器生成。
COPYWRITER_TITLE_PROVIDER_ORDER=gemini
COPYWRITER_AGY_BIN=agy
COPYWRITER_AGY_MODEL=gemini-3.7-flash-high
COPYWRITER_AGY_TIMEOUT_SECONDS=45
# 开启后，封面改读 *_display_title.txt；后台与视频顶部仍使用 *_title.txt。
ENABLE_DUAL_TITLE_DISPLAY=false

# Subtitle translation provider order.
# 正式生产基线：Gemini 主译，DeepSeek 次选，Google 终级兜底。
# 三天影子期由独立 AGY 评估脚本生成候选，绝不改变本链路输出。
SUBTITLE_TRANSLATION_PROVIDER_ORDER=gemini,deepseek,google

# agy CLI runs in an isolated temporary directory with plan+sandbox and JSON Schema output.
AGY_COMMAND=agy
AGY_TIMEOUT_SEC=90
AGY_SUBTITLE_MODEL=gemini-3.7-flash-high
AGY_DUBBING_MODEL=claude-sonnet-4-6
ENABLE_AGY_SUBTITLE_SHADOW_REVIEW=false
AGY_SHADOW_REPORT_DIR=output/agy_shadow
AGY_SHADOW_MAX_SEGMENTS=80

# DeepSeek OpenAI-compatible API.
# DeepSeek is inactive unless "deepseek" appears in SUBTITLE_TRANSLATION_PROVIDER_ORDER.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ENABLE_DEEPSEEK_VOCAB_FALLBACK=true
# DeepSeek 只可在此预算内作为质量对比候选；超时后回退到此前可用候选，避免占满发布窗口。
DEEPSEEK_SUBTITLE_TOTAL_TIMEOUT_SECONDS=300

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# WeChat automation
WECHAT_HEADLESS=false
WECHAT_KEEPALIVE_ENABLED=false
WECHAT_KEEPALIVE_MIN_INTERVAL=50
WECHAT_KEEPALIVE_MAX_INTERVAL=65
WECHAT_KEEPALIVE_DWELL=15
WECHAT_SESSION_WARN_HOURS=22.0
WECHAT_AUTO_RELOGIN_ENABLED=false
# 仅在网页“微信快捷登录”触发后，尝试点击本机 WeChat 的受限登录/授权窗口。
# 先运行 scripts/wechat_uploader.py --desktop-auth-preflight；通过后才设为 true。
ENABLE_WECHAT_DESKTOP_QUICK_LOGIN=false
WECHAT_DESKTOP_QUICK_LOGIN_TIMEOUT_SECONDS=15
# 辅助功能树不暴露原生“允许”时的视觉后备；仅网页快捷登录后且唯一微信绿按钮候选时点击。
ENABLE_WECHAT_DESKTOP_VISUAL_AUTH_FALLBACK=false
# 英语世界短视频：通过本地质检后由独立账本自动提交；旧审核项和未确认提交绝不自动重传。
ENABLE_ENGLISH_WORLD_AUTO_PUBLISH=false

# YouTube cookies
YOUTUBE_COOKIES_FILE=
# refresh_yt_cookies.py 只在此探针元数据成功后原子替换生产 Cookie；不会下载或发布。
YOUTUBE_AUTH_PROBE_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw
YOUTUBE_COOKIE_BROWSER=chrome
# 仅 YouTube 明确要求验证时才自动刷新 Cookie 并重试一次源字幕预检。
ENABLE_YOUTUBE_COOKIE_AUTO_REFRESH=false

# Official YouTube Data API v3 key for channel discovery and scoring metadata.
# Leave empty only for RSS degraded mode: new videos are retained as METADATA_PENDING
# and cannot enter automatic publishing until complete metadata is available.
YOUTUBE_DATA_API_KEY=
YOUTUBE_DATA_API_TIMEOUT_SEC=20
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=900

# Dashboard
DASHBOARD_PORT=9100
LOG_LEVEL=INFO

# Feature flags, default off for production safety
ENABLE_BLACKLIST_TOMBSTONE=false
ENABLE_MANUAL_SCORE_LOCK=false
ENABLE_CENSORSHIP_ENGINE=false
ENABLE_CHANNEL_POLICY_FILTER=false
ENABLE_EXTERNAL_CENSOR_RULES=false
ENABLE_SUBTITLE_CENSORSHIP=false
# 跨平台上传前审查使用的 ASS 字幕快照。证据目录当前不自动清理；31 天为未来维护任务不得突破的下限。
SUBTITLE_EVIDENCE_RETENTION_DAYS=31
ENABLE_CHANNEL_POLICY_FAIL_OPEN=false
ENABLE_SIGTERM_KILL=false
ENABLE_DYNAMIC_KEYWORDS=false
ENABLE_SOURCE_DATE_STAMP=false
ENABLE_TRANSLATION_QUALITY_FAIL_OPEN=false
ENABLE_TRANSLATION_NUMERIC_GUARD=false

# 配音再制中心（只由 ./vpanel dubbing 显式启动；不会进入日常自动发布流水线）
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Male_Announcer
MINIMAX_TTS_PREFERRED_SPEED=1.08
MINIMAX_TTS_MIN_SPEED=0.96
MINIMAX_TTS_MAX_SPEED=1.28
MINIMAX_TTS_REQUEST_INTERVAL_SEC=1.1
# 火山豆包语音：仅在 config/dubbing_voice_profiles.json 中有匹配的频道音色时使用。
# 请只把豆包语音控制台创建的专用 API Key 写入本机 .env；禁止提交、写日志或存入数据库。
VOLC_SPEECH_API_KEY=
VOLC_SPEECH_REQUEST_INTERVAL_SEC=0.2
# 非密钥、可提交的频道音色档案。未匹配任何频道时，人工译制自动回退到上方 MiniMax 默认项。
DUBBING_VOICE_PROFILES_PATH=config/dubbing_voice_profiles.json
# 已验收默认：普通话主声道 + 0.16 英文原声底音；可改为 zh_only。
DUBBING_AUDIO_POLICY=zh_with_english_bed
DUBBING_ENGLISH_BED_VOLUME=0.16
DUBBING_TARGET_LUFS=-14.0
# 每次人工选片的混音版在影子期继续使用已批准的 DeepSeek thinking；全部失败即阻断。
DUBBING_DEEPSEEK_SCRIPT_REFINEMENT=true
DUBBING_DEEPSEEK_THINKING_ENABLED=true
DUBBING_DEEPSEEK_REFINEMENT_BATCH_SIZE=6
DUBBING_SCRIPT_REFINEMENT_PROVIDER_ORDER=deepseek
DUBBING_AGY_REFINEMENT_BATCH_SIZE=12
# 字幕页按完整句子展示；超长句仅会在逗号等自然停顿处拆页。
DUBBING_SUBTITLE_FONT_SIZE=72
DUBBING_SUBTITLE_MAX_PAGE_CHARS=28
# 同一字幕页内的单行安全宽度；超过时仅视觉折行，不改变语义页时间轴。
DUBBING_SUBTITLE_MAX_LINE_CHARS=12

# 内容贴合封面：基于现有标题、分类和语义提示生成可审计的视觉策划；默认关闭，不影响例行发布。
ENABLE_CONTENT_AWARE_COVER=false

# Codex 专属底图队列。默认关闭；启用前必须确认 Codex 自动化巡查已真实创建。
ENABLE_CODEX_COVER_QUEUE=false
# Codex 底图到期后先尝试本机 Anti-gravity，调用或验收失败再回退固定背景。
ENABLE_ANTIGRAVITY_COVER_FALLBACK=true
ANTIGRAVITY_RUNTIME_DIR=~/.local/share/videopipeline-antigravity313
ANTIGRAVITY_MODEL=gemini-3.5-flash
ANTIGRAVITY_IMAGE_MODEL=gemini-3.1-flash-image-preview
ANTIGRAVITY_TIMEOUT_SECONDS=90
# 英语世界审核包优先调用 agy + Gemini 生成无字主视觉；失败后回退本地报刊封面，仍需 Telegram 人审。
ENABLE_ENGLISH_WORLD_ANTIGRAVITY_PRIMARY=false
ENGLISH_WORLD_ANTIGRAVITY_MODEL=gemini-3.7-flash-high
ENGLISH_WORLD_ANTIGRAVITY_VARIANTS=3
ENGLISH_WORLD_ANTIGRAVITY_TIMEOUT_SECONDS=180
# 仅将 OCR 疑似插画纹理带入 Telegram 人审，绝不自动放行。
ENGLISH_WORLD_ANTIGRAVITY_ALLOW_OCR_SUSPECT=false
AI_COVER_QUEUE_DIR=ai-cover-queue
AI_COVER_FINISH_DIR=ai-cover-finish
# 外部底图最晚须在 32 分钟内写回；本地协调器会在第 34 分钟启动确定性降级。
AI_COVER_GENERATION_DEADLINE_MINUTES=32
AI_COVER_FALLBACK_AFTER_MINUTES=34

# 快手创作者中心浏览器上传。首次登录请运行 uploader 的 --login-only --no-headless，
# 用创作者账号扫码；会话仅保存于 output/kuaishou_state.json，不需要开放平台 App。
ENABLE_KUAISHOU_BROWSER_PUBLISHING=false
KUAISHOU_BROWSER_HEADLESS=true
# 历史视频向快手迁移的每日数量；新视频双投递不受此限制。
KUAISHOU_HISTORY_DAILY_LIMIT=10

# 抖音创作者中心浏览器上传。首次接入先登录/校准；会话保存于 output/douyin_state.json。
ENABLE_DOUYIN_BROWSER_PUBLISHING=false
DOUYIN_BROWSER_HEADLESS=true
# 抖音补录前三天按 5 条/天；连续 3 天无异常后再放大。
DOUYIN_HISTORY_DAILY_LIMIT=5
# 任意两次抖音创作者中心浏览器动作之间的最小间隔；覆盖审核回查、新片同步与历史补录。
DOUYIN_BROWSER_ACTION_INTERVAL_SEC=180
# 每轮最多回查多少条 UNDER_REVIEW，避免一次性连续打开作品管理页。
DOUYIN_REVIEW_MAX_PER_RUN=5
# 每轮最多同步多少条“微信已发布但抖音未建账”的新片漏项。
DOUYIN_NEW_SYNC_MAX_PER_RUN=10
# 新片自动同步每日上限；每分钟巡航时仍最多领取这么多条。
DOUYIN_NEW_SYNC_DAILY_LIMIT=1
# 仅扫描最近 N 小时内刚完成微信发布的新片，避免把旧历史内容混入 NEW 同步。
DOUYIN_NEW_SYNC_LOOKBACK_HOURS=12

# 视频号被临时停用时设为 true：新片只发快手，视频号进入 WECHAT_DEFERRED，恢复后设回 false。
# 恢复后的每日视频号补发上限；平台确认异常时应暂停并人工复核。
WECHAT_PUBLISHING_PAUSED=false
WECHAT_DEFERRED_RECOVERY_DAILY_LIMIT=10
# 作品管理页回查仅读取后台状态，不提交视频；限制每轮条数和单条超时。
WECHAT_REVIEW_MAX_PER_RUN=0
WECHAT_REVIEW_TIMEOUT_SECONDS=180

# 仅在启用发布时段限制时使用的非窗口预加工：先无视频下载拉取 VTT 字幕并审查，
# 通过后才下载/渲染；仅处理 AUTO 候选，绝不在这里提交到任何平台。
ENABLE_BACKGROUND_PREPARATION=true
BACKGROUND_PREPARATION_BATCH_LIMIT=1
SOURCE_SUBTITLE_LANGUAGES=en.*,en
SOURCE_SUBTITLE_RETRY_HOURS=6

# 公开视频提交窗口：默认关闭，审核与成片完成后立即提交，不等待时段。
# 设为 true 才按下列工作日/节假日窗口限制提交。
ENABLE_PUBLIC_PUBLISH_WINDOWS=false
PUBLIC_PUBLISH_TIMEZONE=Asia/Shanghai
PUBLIC_PUBLISH_WINDOWS=06:30-09:00,11:15-12:45,17:00-18:15,19:00-20:40
# 周末/法定节假日：通勤峰弱化，上午从 07:30 开始，下午和晚间休闲窗口更长。
PUBLIC_PUBLISH_HOLIDAY_WINDOWS=07:30-11:00,13:30-16:30,19:00-21:30
# 中国大陆 2026 年国务院办公厅节假日/补班日；补班日优先级高于周末。
CHINA_PUBLIC_HOLIDAYS=2026-01-01..2026-01-03,2026-02-15..2026-02-23,2026-04-04..2026-04-06,2026-05-01..2026-05-05,2026-06-19..2026-06-21,2026-09-25..2026-09-27,2026-10-01..2026-10-07
CHINA_MAKEUP_WORKDAYS=2026-01-04,2026-02-14,2026-02-28,2026-05-09,2026-09-20,2026-10-10

# 本轮平台补录中 Wall Street Truthbombs 的源视频发布日期下界（YYYYMMDD）。
PLATFORM_BACKFILL_WALL_STREET_SINCE_UPLOAD_DATE=20260713

# 演讲/TED/高校频道的自动发布线；普通频道仍为 75
SPEECH_PUBLISH_SCORE_LINE=40

# Candidate scores are refreshed immediately after input metrics change, otherwise on this TTL.
SCORE_REFRESH_INTERVAL_MINUTES=180
