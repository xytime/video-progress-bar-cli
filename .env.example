# Video-precessing environment template
# Copy the keys you need into .env and fill real secrets there.

# Core AI providers
GEMINI_API_KEY=

# Subtitle translation provider order.
# Gemini 主译，DeepSeek 交叉候选，Google Translate 终级兜底。
SUBTITLE_TRANSLATION_PROVIDER_ORDER=gemini,deepseek,google

# DeepSeek OpenAI-compatible API.
# DeepSeek is inactive unless "deepseek" appears in SUBTITLE_TRANSLATION_PROVIDER_ORDER.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ENABLE_DEEPSEEK_VOCAB_FALLBACK=false

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# WeChat automation
WECHAT_HEADLESS=false
WECHAT_KEEPALIVE_ENABLED=false
WECHAT_KEEPALIVE_MIN_INTERVAL=50
WECHAT_KEEPALIVE_MAX_INTERVAL=65
WECHAT_KEEPALIVE_DWELL=15
WECHAT_SESSION_WARN_HOURS=22.0
WECHAT_AUTO_RELOGIN_ENABLED=false

# YouTube cookies
YOUTUBE_COOKIES_FILE=

# Official YouTube Data API v3 key for channel discovery and scoring metadata.
# Leave empty only for RSS degraded mode: new videos are retained as METADATA_PENDING
# and cannot enter automatic publishing until complete metadata is available.
YOUTUBE_DATA_API_KEY=
YOUTUBE_DATA_API_TIMEOUT_SEC=20

# Dashboard
DASHBOARD_PORT=9100
LOG_LEVEL=INFO

# Feature flags, default off for production safety
ENABLE_BLACKLIST_TOMBSTONE=false
ENABLE_MANUAL_SCORE_LOCK=false
ENABLE_CENSORSHIP_ENGINE=false
ENABLE_CHANNEL_POLICY_FILTER=false
ENABLE_EXTERNAL_CENSOR_RULES=false
ENABLE_SUBTITLE_CENSORSHIP=false
ENABLE_CHANNEL_POLICY_FAIL_OPEN=false
ENABLE_SIGTERM_KILL=false
ENABLE_DYNAMIC_KEYWORDS=false
ENABLE_SOURCE_DATE_STAMP=false
ENABLE_TRANSLATION_QUALITY_FAIL_OPEN=false
ENABLE_TRANSLATION_NUMERIC_GUARD=false

# 快手创作者中心浏览器上传。首次登录请运行 uploader 的 --login-only --no-headless，
# 用创作者账号扫码；会话仅保存于 output/kuaishou_state.json，不需要开放平台 App。
ENABLE_KUAISHOU_BROWSER_PUBLISHING=false
KUAISHOU_BROWSER_HEADLESS=true
# 历史视频向快手迁移的每日数量；新视频双投递不受此限制。
KUAISHOU_HISTORY_DAILY_LIMIT=10

# 抖音创作者中心浏览器上传。首次接入先登录/校准；会话保存于 output/douyin_state.json。
ENABLE_DOUYIN_BROWSER_PUBLISHING=false
DOUYIN_BROWSER_HEADLESS=true
# 抖音补录前三天按 5 条/天；连续 3 天无异常后再放大。
DOUYIN_HISTORY_DAILY_LIMIT=5
# 任意两次抖音创作者中心浏览器动作之间的最小间隔；覆盖审核回查、新片同步与历史补录。
DOUYIN_BROWSER_ACTION_INTERVAL_SEC=180
# 每轮最多回查多少条 UNDER_REVIEW，避免一次性连续打开作品管理页。
DOUYIN_REVIEW_MAX_PER_RUN=5

# 视频号被临时停用时设为 true：新片只发快手，视频号进入 WECHAT_DEFERRED，恢复后设回 false。
# 恢复后的每日视频号补发上限；避免把停用期间积压的视频一次性全部补发。
WECHAT_PUBLISHING_PAUSED=false
WECHAT_DEFERRED_RECOVERY_DAILY_LIMIT=5

# 公开视频提交窗口：只限制会产生公开视频的提交动作；审核回查等只读动作不受影响。
# 默认按北京时间短视频活跃规律设置：早通勤、午休、晚通勤、晚间黄金档。
# 各窗口相对统计峰值整体提前 30 分钟；晚间窗口仍避开本机 21:15 起的美股盘中重负载保护。
ENABLE_PUBLIC_PUBLISH_WINDOWS=true
PUBLIC_PUBLISH_TIMEZONE=Asia/Shanghai
PUBLIC_PUBLISH_WINDOWS=07:00-08:00,11:15-12:45,17:00-18:15,19:00-20:40

# 本轮平台补录中 Wall Street Truthbombs 的源视频发布日期下界（YYYYMMDD）。
PLATFORM_BACKFILL_WALL_STREET_SINCE_UPLOAD_DATE=20260713

# 演讲/TED/高校频道的自动发布线；普通频道仍为 75
SPEECH_PUBLISH_SCORE_LINE=40
