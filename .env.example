# Video-precessing environment template
# Copy the keys you need into .env and fill real secrets there.

# Core AI providers
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ALIYUN_MT_ACCESS_KEY_ID=
ALIYUN_MT_ACCESS_KEY_SECRET=

# Subtitle translation provider order.
# Default keeps existing behavior: Gemini -> Aliyun MT -> Google Translate.
# To test DeepSeek without removing fallbacks, use: gemini,deepseek,aliyun,google
SUBTITLE_TRANSLATION_PROVIDER_ORDER=gemini,aliyun,google

# DeepSeek OpenAI-compatible API.
# DeepSeek is inactive unless "deepseek" appears in SUBTITLE_TRANSLATION_PROVIDER_ORDER.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# WeChat automation
WECHAT_HEADLESS=true
WECHAT_KEEPALIVE_ENABLED=false
WECHAT_KEEPALIVE_MIN_INTERVAL=50
WECHAT_KEEPALIVE_MAX_INTERVAL=65
WECHAT_KEEPALIVE_DWELL=15
WECHAT_SESSION_WARN_HOURS=22.0
WECHAT_AUTO_RELOGIN_ENABLED=false

# YouTube cookies
YOUTUBE_COOKIES_FILE=

# Dashboard
DASHBOARD_PORT=9100
LOG_LEVEL=INFO

# Feature flags, default off for production safety
ENABLE_BLACKLIST_TOMBSTONE=false
ENABLE_MANUAL_SCORE_LOCK=false
ENABLE_CENSORSHIP_ENGINE=false
ENABLE_CHANNEL_POLICY_FILTER=false
ENABLE_EXTERNAL_CENSOR_RULES=false
ENABLE_SUBTITLE_CENSORSHIP=false
ENABLE_CHANNEL_POLICY_FAIL_OPEN=false
ENABLE_SIGTERM_KILL=false
ENABLE_DYNAMIC_KEYWORDS=false
ENABLE_SOURCE_DATE_STAMP=false
ENABLE_TRANSLATION_QUALITY_FAIL_OPEN=false
