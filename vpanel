#!/usr/bin/env bash
# =======================================================================
# Video Pipeline Control CLI (vpanel)
#
# # Modification History
# | Version | Date | Author | Description |
# | --- | --- | --- | --- |
# | 1.0.0 | 2026-05-21 | Gemini_3.5_Flash_planning | 初始创建 vpanel，支持 ui/job 命令组管理 |
# | 1.1.0 | 2026-05-21 | Claude_Sonnet_4.6_Thinking_planning | 修复硬编码路径、set -e 静默崩溃、stop 未等待进程、help 命令缺失、tail 行数不足 |
# | 1.2.0 | 2026-05-22 | Claude_Sonnet_4.6_Thinking_planning | 新增 bot 命令组：透传 bot_daemon.py，零业务逻辑 |
# | 1.3.0 | 2026-05-28 | Gemini_3.5_Flash_planning | 使用 python -u 启用无缓冲输出以实时更新日志 |
# | 1.4.0 | 2026-07-13 | Codex | UI 检测 LaunchAgent 后统一由 launchd 启停，避免 KeepAlive 与 nohup 双重管理争抢端口 |
# | 1.4.1 | 2026-07-27 | Codex | 端口变量输出统一使用 ${DASH_PORT}，避免 set -u 下中文标点紧邻变量导致误解析 |
# | 1.4.2 | 2026-07-27 | Codex | _port_pid 增加 netstat fallback，避免 lsof 受异常挂载影响误报 UI 未监听 |
# =======================================================================

# [Claude_Sonnet_4.6_Thinking_planning] 严格错误处理，但用于流程控制的命令须显式处理退出码
# 注意：不使用 set -e，因为 ps/kill 的非零退出码属于正常控制流（非错误）
set -u  # 未定义变量立即报错

# [Claude_Sonnet_4.6_Thinking_planning] P1修复：从脚本自身位置动态推导项目根目录，避免硬编码绝对路径
# BASH_SOURCE[0] 在脚本被 source 或通过别名调用时也能正确工作
PRJ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PRJ_ROOT"

# 定义相关路径与常量
VENV_DIR="$PRJ_ROOT/.venv"
PYTHON="$VENV_DIR/bin/python"
PID_FILE="$PRJ_ROOT/output/dashboard.pid"
UI_LOG_FILE="$PRJ_ROOT/output/dashboard.log"
JOB_LOG_FILE="$PRJ_ROOT/output/pipeline.log"
LAUNCH_LABEL="com.videopipeline.ui"
LAUNCH_PLIST="$HOME/Library/LaunchAgents/$LAUNCH_LABEL.plist"
LAUNCH_LOG="/tmp/videopipeline-ui.log"
LAUNCH_DOMAIN="gui/$(id -u)"

# [Claude_Opus_4.8] 仪表盘端口（与 settings.dashboard_port 一致，支持 DASHBOARD_PORT 覆盖）
DASH_PORT="${DASHBOARD_PORT:-9100}"
DASH_PATTERN="src/web/app.py"

# 进程发现以「端口归属」为权威判断（PID 文件易漂移，曾导致 stop 漏杀真服务进程、
# start 不察端口被占而硬起游离僵进程）。_all_dash_pids 同时覆盖游离进程与占端口者。
_dash_pids()     { pgrep -f "$DASH_PATTERN" 2>/dev/null; }
_port_pid() {
    local pid
    pid="$(lsof -nP -iTCP:"$DASH_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1)"
    if [ -n "$pid" ]; then
        echo "$pid"
        return 0
    fi
    netstat -anv -p tcp 2>/dev/null \
        | awk -v port=".$DASH_PORT" '$0 ~ port && $0 ~ /LISTEN/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /:[0-9]+$/) {
                    split($i, parts, ":")
                    print parts[length(parts)]
                    exit
                }
            }
        }'
}
_all_dash_pids() { printf '%s\n%s\n' "$(_dash_pids)" "$(_port_pid)" | sort -u | grep -v '^$'; }
_launch_loaded()  { launchctl print "$LAUNCH_DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1; }

# 确保 output 目录存在
mkdir -p "$PRJ_ROOT/output"

# 确保使用虚拟环境
if [ ! -d "$VENV_DIR" ]; then
    echo "❌ 错误: 未找到虚拟环境 $VENV_DIR"
    echo "请先运行 python -m venv .venv 并配置环境"
    exit 1
fi

# -----------------------------------------------------------------------
# 帮助信息
# -----------------------------------------------------------------------
show_usage() {
    echo "📺 Video Pipeline 快捷控制工具 (vpanel)"
    echo "用法: ./vpanel [命令组] [操作]"
    echo ""
    echo "命令组: ui (仪表盘管理)"
    echo "  ./vpanel ui start             后台启动控制中心仪表盘 (http://localhost:9100)"
    echo "  ./vpanel ui stop              停止控制中心仪表盘（清光所有进程 + 释放端口）"
    echo "  ./vpanel ui restart           重启控制中心（彻底清停 → 验证端口 → 验证绑定）"
    echo "  ./vpanel ui status            查看控制中心运行状态"
    echo "  ./vpanel ui logs              实时查看控制中心日志（最近 50 行）"
    echo "  ./vpanel ui open              在浏览器中打开仪表盘"
    echo ""
    echo "命令组: job (自动化管线任务)"
    echo "  ./vpanel job run              启动单次全自动管线任务 (抓取 + 加工 + 发布)"
    echo "  ./vpanel job logs             实时查看管线运行日志（最近 50 行）"
    echo "  ./vpanel job channels         列出当前已批准的频道白名单"
    echo "  ./vpanel job add-channel URL  通过 yt-dlp 验证并添加一个 YouTube 频道到白名单"
    echo ""
    echo "命令组: bot (Telegram Bot 管理)"
    echo "  ./vpanel bot start            后台启动 Telegram Bot"
    echo "  ./vpanel bot stop             停止 Telegram Bot"
    echo "  ./vpanel bot status           查看 Bot 运行状态"
    echo "  ./vpanel bot logs             实时查看 Bot 日志（最近 50 行）"
    echo "  ./vpanel bot restart          重启 Bot"
    echo ""
    echo "通用:"
    echo "  ./vpanel help                 显示此帮助信息"
    echo ""
}

# -----------------------------------------------------------------------
# 仪表盘控制 (UI)
# -----------------------------------------------------------------------
ui_start() {
    # [Claude_Opus_4.8] 权威判断：端口已被占用 = 已在运行（不再只信易漂移的 PID 文件）
    local pp; pp="$(_port_pid)"
    if [ -n "$pp" ]; then
        echo "ℹ️ 控制中心已在运行 (PID: $pp, http://localhost:${DASH_PORT})"
        echo "$pp" > "$PID_FILE"
        return 0
    fi

    if [ -f "$LAUNCH_PLIST" ]; then
        echo "🚀 正在通过 launchd 启动控制中心仪表盘..."
        if ! _launch_loaded; then
            launchctl bootstrap "$LAUNCH_DOMAIN" "$LAUNCH_PLIST" || return 1
        else
            launchctl kickstart "$LAUNCH_DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1 || true
        fi
        local i bound
        for i in $(seq 1 20); do
            sleep 0.5
            bound="$(_port_pid)"
            if [ -n "$bound" ]; then
                echo "$bound" > "$PID_FILE"
                echo "✅ 启动成功！端口 :${DASH_PORT} 由 PID $bound 接管"
                echo "🌐 仪表盘地址: http://localhost:${DASH_PORT}"
                echo "📄 launchd 日志: $LAUNCH_LOG"
                return 0
            fi
        done
        echo "❌ launchd 未能绑定端口 :${DASH_PORT}，请检查日志: $LAUNCH_LOG"
        return 1
    fi

    # 清理「持有 app.py 但没绑端口」的游离/僵进程（如端口冲突起飞失败的残留）
    local strays; strays="$(_dash_pids)"
    if [ -n "$strays" ]; then
        echo "🧹 清理未绑定端口的游离进程: $(echo "$strays" | tr '\n' ' ')"
        for p in $strays; do kill "$p" 2>/dev/null || true; done
        sleep 1
        for p in $(_dash_pids); do kill -9 "$p" 2>/dev/null || true; done
    fi

    echo "🚀 正在启动控制中心仪表盘..."
    nohup "$PYTHON" -u "$PRJ_ROOT/src/web/app.py" > "$UI_LOG_FILE" 2>&1 &
    NEW_PID=$!
    echo "$NEW_PID" > "$PID_FILE"

    # 成功判据 = 新进程「真的绑上了端口」，而非仅"进程还活着"（旧 bug 根因）
    local i bound
    for i in $(seq 1 20); do
        sleep 0.5
        bound="$(_port_pid)"
        if [ "$bound" = "$NEW_PID" ]; then
            echo "✅ 启动成功！端口 :${DASH_PORT} 由 PID $NEW_PID 接管"
            echo "🌐 仪表盘地址: http://localhost:${DASH_PORT}"
            echo "📄 日志文件: output/dashboard.log"
            return 0
        fi
        ps -p "$NEW_PID" > /dev/null 2>&1 || break   # 进程提前退出 → 失败
    done
    echo "❌ 启动失败/未能绑定端口 :${DASH_PORT}，请检查日志: output/dashboard.log"
    rm -f "$PID_FILE"
    return 1
}

ui_stop() {
    # [Claude_Opus_4.8] 杀光所有 dashboard 进程 + 占端口者（不再只杀 PID 文件那一个，
    # 避免 PID 文件漂移后漏掉真正在服务的进程；并在最后验证端口确已释放）
    if _launch_loaded; then
        echo "🛑 正在停止 launchd 控制中心..."
        launchctl bootout "$LAUNCH_DOMAIN/$LAUNCH_LABEL" 2>/dev/null || true
    fi
    local pids; pids="$(_all_dash_pids)"
    if [ -z "$pids" ]; then
        echo "ℹ️ 控制中心未在运行"
        rm -f "$PID_FILE"
        return 0
    fi
    echo "🛑 正在停止控制中心 (PID: $(echo "$pids" | tr '\n' ' '))..."
    for p in $pids; do kill "$p" 2>/dev/null || true; done   # 优雅 SIGTERM
    local i
    for i in $(seq 1 12); do                                  # 等待最多 ~6s 退出+释放端口
        sleep 0.5
        [ -z "$(_all_dash_pids)" ] && break
    done
    local left; left="$(_all_dash_pids)"
    if [ -n "$left" ]; then
        echo "⚡ 进程未响应，强制终止: $(echo "$left" | tr '\n' ' ')"
        for p in $left; do kill -9 "$p" 2>/dev/null || true; done
        sleep 0.5
    fi
    rm -f "$PID_FILE"
    if [ -n "$(_port_pid)" ]; then
        echo "❌ 端口 :${DASH_PORT} 仍被 PID $(_port_pid) 占用，请人工检查"
        return 1
    fi
    echo "✅ 已停止，端口 :${DASH_PORT} 已释放"
}

ui_restart() {
    # [Claude_Opus_4.8] 真正的重启：彻底清停（含游离进程）→ 验证端口释放 → 验证绑定启动
    echo "🔄 重启控制中心..."
    ui_stop || true
    sleep 1
    ui_start
}

ui_status() {
    # [Claude_Opus_4.8] 以端口归属为准，并主动报告游离进程
    local pp; pp="$(_port_pid)"
    if [ -n "$pp" ]; then
        echo "🟢 运行中 (PID: $pp, 端口 :${DASH_PORT})"
        echo "🌐 仪表盘地址: http://localhost:${DASH_PORT}"
        echo "🕒 运行时间: $(ps -p "$pp" -o etime= | xargs)"
    else
        echo "🔴 已停止（端口 :${DASH_PORT} 无监听）"
    fi
    local strays; strays="$(_dash_pids | grep -vx "$pp" 2>/dev/null)"
    if [ -n "$strays" ]; then
        echo "⚠️ 检测到游离 app.py 进程(未绑端口): $(echo "$strays" | tr '\n' ' ')"
        echo "   建议 './vpanel ui restart' 一键清理并重启"
    fi
}

ui_logs() {
    local log_file="$UI_LOG_FILE"
    [ -f "$LAUNCH_PLIST" ] && [ -f "$LAUNCH_LOG" ] && log_file="$LAUNCH_LOG"
    if [ -f "$log_file" ]; then
        echo "📄 正在追踪控制中心日志 (按 Ctrl+C 退出)..."
        # [Claude_Sonnet_4.6_Thinking_planning] P3修复：-n 50 显示最近 50 行，提供足够上下文
        tail -f -n 50 "$log_file"
    else
        echo "ℹ️ 日志文件尚未创建，请先运行 './vpanel ui start'"
    fi
}

ui_open() {
    if [ -f "$PID_FILE" ] && ps -p "$(cat "$PID_FILE")" > /dev/null 2>&1; then
        open "http://localhost:${DASH_PORT}"
    else
        echo "⚠️ 仪表盘未在运行，请先执行 './vpanel ui start'"
    fi
}

# -----------------------------------------------------------------------
# 管线任务控制 (JOB)
# -----------------------------------------------------------------------
job_run() {
    echo "🔥 [点火] 开始执行单次全自动流水线..."
    echo "1. 正在检索监控频道获取最新视频..."
    if ! "$PYTHON" "$PRJ_ROOT/scripts/monitor_channels.py"; then
        echo "⚠️  monitor_channels.py 运行出错（可能是网络问题）"
        echo "   将继续尝试处理数据库中已有的 PENDING 视频..."
    fi

    echo "2. 正在启动管线管理器处理高评分视频并发布..."
    # [Claude_Sonnet_4.6_Thinking_planning] 修复：pipeline_manager.py 含相对导入，
    # 用 PYTHONPATH 注入 src/ 让 -m 能找到 video_processing 包，无需 cd 进目录
    PYTHONPATH="$PRJ_ROOT/src" nohup "$PYTHON" -m video_processing.pipeline_manager \
        >> "$JOB_LOG_FILE" 2>&1 &
    JOB_PID=$!
    echo "✅ 管线后台任务已启动 (PID: $JOB_PID)"
    echo "📄 详细加工过程将写入: output/pipeline.log"
    echo "⏳ Whisper 阶段耗时最长（30~90分钟），请耐心等待"
    echo "💡 运行 './vpanel job logs' 或打开仪表盘跟踪进度"
}


job_logs() {
    if [ -f "$JOB_LOG_FILE" ]; then
        echo "📄 正在追踪管线执行日志 (按 Ctrl+C 退出)..."
        tail -f -n 50 "$JOB_LOG_FILE"
    else
        echo "ℹ️ 管线运行日志尚未创建，请先运行一次 './vpanel job run'"
    fi
}

job_channels() {
    echo "📡 当前已批准的频道白名单："
    "$PYTHON" -c "
import sys; sys.path.insert(0, '$PRJ_ROOT/src')
from video_processing.db.database import PipelineDB
db = PipelineDB()
channels = db.get_approved_channels()
if not channels:
    print('  (空)暂无已批准频道，请运行 ./vpanel job add-channel <URL>')
else:
    for c in channels:
        print(f\"  ✅ {c['channel_name']:30s} {c['channel_id']}\")
print(f'\n共 {len(channels)} 个已批准频道')
"
}

job_add_channel() {
    local URL="${1:-}"
    if [ -z "$URL" ]; then
        echo "❌ 用法: ./vpanel job add-channel <YouTube频道URL>"
        echo "   示例: ./vpanel job add-channel https://www.youtube.com/@TheVerge"
        exit 1
    fi

    echo "🔍 正在通过 yt-dlp 验证频道 ID（验证过才入库，防止错误 ID）..."
    INFO=$(.venv/bin/yt-dlp --print "%(channel_id)s|%(channel)s" \
        --playlist-items 1 --no-warnings \
        --cookies-from-browser safari \
        "$URL" 2>&1)

    if echo "$INFO" | grep -q "ERROR"; then
        echo "❌ yt-dlp 无法访问该 URL："
        echo "   $INFO"
        exit 1
    fi

    CHANNEL_ID=$(echo "$INFO" | head -1 | cut -d'|' -f1)
    CHANNEL_NAME=$(echo "$INFO" | head -1 | cut -d'|' -f2)

    if [ -z "$CHANNEL_ID" ]; then
        echo "❌ 未能解析到频道 ID，请检查 URL 格式"
        exit 1
    fi

    echo "  频道名: $CHANNEL_NAME"
    echo "  频道ID: $CHANNEL_ID"

    "$PYTHON" -c "
import sys; sys.path.insert(0, '$PRJ_ROOT/src')
from video_processing.db.database import PipelineDB
db = PipelineDB()
ok = db.add_channel('$CHANNEL_ID', '$CHANNEL_NAME', status='APPROVED', reason='Added via vpanel job add-channel')
if ok:
    print('✅ 已添加并批准')
else:
    print('ℹ️ 已存在，记录已更新')
"
}

# -----------------------------------------------------------------------
# 核心分流器
# -----------------------------------------------------------------------
GROUP=${1:-""}
ACTION=${2:-""}

if [ -z "$GROUP" ]; then
    show_usage
    exit 0
fi

case "$GROUP" in
    ui)
        case "$ACTION" in
            start)   ui_start ;;
            stop)    ui_stop ;;
            restart) ui_restart ;;
            status)  ui_status ;;
            logs)    ui_logs ;;
            open)    ui_open ;;
            *)
                echo "❌ 错误: 未知操作 '$ACTION'"
                show_usage
                exit 1
                ;;
        esac
        ;;
    job)
        case "$ACTION" in
            run)         job_run ;;
            logs)        job_logs ;;
            channels)    job_channels ;;
            add-channel) job_add_channel "${3:-}" ;;
            *)
                echo "❌ 错误: 未知操作 '$ACTION'"
                show_usage
                exit 1
                ;;
        esac
        ;;
    # [Claude_Sonnet_4.6_Thinking_planning] P2修复：注册 help 为有效命令，避免 './vpanel help' 报错
    help)
        show_usage
        ;;
    # [Claude_Sonnet_4.6_Thinking_planning] 1.2.0: bot 命令组 — 4 行透传网关，零业务逻辑
    bot)
        case "$ACTION" in
            start|stop|status|restart)
                "$PYTHON" "$PRJ_ROOT/scripts/bot_daemon.py" "$ACTION"
                ;;
            logs)
                BOT_LOG="$PRJ_ROOT/output/bot.log"
                if [ -f "$BOT_LOG" ]; then
                    echo "📄 正在追踪 Bot 日志 (按 Ctrl+C 退出)..."
                    tail -f -n 50 "$BOT_LOG"
                else
                    echo "ℹ️ Bot 日志尚未创建，请先运行 './vpanel bot start'"
                fi
                ;;
            *)
                echo "❌ 错误: 未知操作 '$ACTION'"
                show_usage
                exit 1
                ;;
        esac
        ;;
    *)
        echo "❌ 错误: 未知命令组 '$GROUP'"
        show_usage
        exit 1
        ;;
esac
