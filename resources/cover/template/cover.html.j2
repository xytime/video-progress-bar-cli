<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>Cover Render Template</title>
    <style>
        :root {
            --bg-start: {{ background_gradient_start }};
            --bg-end: {{ background_gradient_end }};
            --accent-color: {{ accent_color }};
            --accent-glow: {{ accent_glow }};
            --grid-color: {{ grid_color }};
            --noise-opacity: {{ noise_opacity }};
        }

        html, body {
            margin: 0;
            padding: 0;
            width: {{ canvas_width }}px;
            height: {{ canvas_height }}px;
            background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
            font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "STHeiti", "Microsoft YaHei", sans-serif;
            overflow: hidden;
            position: relative;
            box-sizing: border-box;
        }

        /* 氛围发光球 */
        .orb-container {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
            pointer-events: none;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(180px);
            mix-blend-mode: screen;
            opacity: 0.75;
        }

        /* 点阵网格 */
        .grid-layer {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 2;
            background-image: radial-gradient(var(--grid-color) 2.5px, transparent 0);
            background-size: 80px 80px;
            background-position: 40px 40px;
        }

        /* 磨砂玻璃卡片 */
        .glass-card {
            position: absolute;
            left: {{ safe_zone.margin_pct }}%;
            right: {{ safe_zone.margin_pct }}%;
            top: 50%;
            transform: translateY(-50%);
            height: 950px;
            background: rgba(255, 255, 255, 0.05);
            border: 3px solid rgba(255, 255, 255, 0.18);
            border-radius: 60px;
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            z-index: 10;
            box-sizing: border-box;
            padding: 85px 70px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
        }

        /* 徽章 */
        .badge-capsule {
            background: #ffffff;
            color: #0f172a;
            padding: 12px 40px;
            border-radius: 40px;
            font-size: 38px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
            margin-bottom: 20px;
        }

        /* 内容文字容器 */
        .text-content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            margin: 40px 0;
        }

        /* 主标题 */
        .main-title {
            font-size: 96px;
            font-weight: 900;
            color: #ffffff;
            text-align: center;
            line-height: 1.35;
            text-shadow: 0 10px 30px rgba(0, 0, 0, 0.65);
            word-break: break-all;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* 副标题 */
        .sub-title {
            font-size: 54px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.85);
            text-align: center;
            line-height: 1.45;
            text-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
            margin-top: 50px;
            word-break: break-all;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* 隐喻矢量图标 */
        .metaphor-icon {
            position: absolute;
            width: 110px;
            height: 110px;
            z-index: 15;
            opacity: 0.65;
            color: var(--accent-color);
            filter: drop-shadow(0 0 12px var(--accent-color));
        }

        .metaphor-icon svg {
            width: 100%;
            height: 100%;
            stroke: currentColor;
            stroke-width: 1.5;
            fill: none;
        }

        /* 定位布局配置 */
        .pos-top-right {
            top: 75px;
            right: 70px;
        }

        .pos-bottom-left {
            bottom: 75px;
            left: 70px;
        }
    </style>
</head>
<body>
    <!-- 点阵网格层 -->
    <div class="grid-layer"></div>

    <!-- 氛围光晕层 -->
    <div class="orb-container">
        {% for orb in orbs %}
        <div class="orb" style="
            left: {{ orb.cx_pct * 100 }}%;
            top: {{ orb.cy_pct * 100 }}%;
            width: {{ orb.radius_pct * 1080 * 2 }}px;
            height: {{ orb.radius_pct * 1080 * 2 }}px;
            transform: translate(-50%, -50%);
            background: radial-gradient(circle, rgba({{ orb.color_rgba[0] }}, {{ orb.color_rgba[1] }}, {{ orb.color_rgba[2] }}, {{ orb.color_rgba[3] / 255 }}) 0%, transparent 70%);
        "></div>
        {% endfor %}
    </div>

    <!-- [Gemini_2.5_Pro_planning] SVG丝带角标：右上角对角线织物丝带，精确几何路径 -->
    {% if content_label is defined and content_label %}
    {% if content_label in ['重磅', '突发', '警示'] %}
      {% set _rl = '#ef4444' %}{% set _rc = '#b91c1c' %}{% set _rd = '#7f1d1d' %}{% set _rt = '#ffffff' %}
    {% elif content_label in ['独家', '首发', '专访'] %}
      {% set _rl = '#fcd34d' %}{% set _rc = '#d97706' %}{% set _rd = '#78350f' %}{% set _rt = '#000000' %}
    {% elif content_label == '最新' %}
      {% set _rl = '#67e8f9' %}{% set _rc = '#0891b2' %}{% set _rd = '#164e63' %}{% set _rt = '#ffffff' %}
    {% elif content_label in ['深度', '解析', '完整版'] %}
      {% set _rl = '#c4b5fd' %}{% set _rc = '#7c3aed' %}{% set _rd = '#4c1d95' %}{% set _rt = '#ffffff' %}
    {% elif content_label == '揭秘' %}
      {% set _rl = '#fdba74' %}{% set _rc = '#ea580c' %}{% set _rd = '#7c2d12' %}{% set _rt = '#ffffff' %}
    {% elif content_label == '局势' %}
      {% set _rl = '#93c5fd' %}{% set _rc = '#1d4ed8' %}{% set _rd = '#1e3a8a' %}{% set _rt = '#ffffff' %}
    {% else %}
      {% set _rl = '#9ca3af' %}{% set _rc = '#374151' %}{% set _rd = '#111827' %}{% set _rt = '#ffffff' %}
    {% endif %}
    <!-- [Gemini_3.5_Flash_planning] 右上角丝带定位从 top:0 下移到 top:240px，使其在 3:4 裁剪比例下完全可见 -->
    <div style="position:absolute; top:240px; right:0; width:400px; height:400px; z-index:30; overflow:hidden; pointer-events:none;">
      <svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- 跨丝带宽度方向的渐变：高光→主色→阴影，模拟织物立体感 -->
          <!-- 渐变方向：从右上角(upper edge)到左下角(lower edge)，垂直于丝带长轴 -->
          <linearGradient id="lrg" x1="270" y1="0" x2="130" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="{{ _rl }}"/>
            <stop offset="45%" stop-color="{{ _rc }}"/>
            <stop offset="100%" stop-color="{{ _rd }}"/>
          </linearGradient>
          <!-- 阴影滤镜，制造悬浮感 -->
          <filter id="lrs" x="-5%" y="-5%" width="110%" height="110%">
            <feDropShadow dx="-3" dy="6" stdDeviation="10" flood-color="rgba(0,0,0,0.65)"/>
          </filter>
        </defs>
        <!--
          几何设计（画布400×400，丝带在右上角）：
          丝带方向：45° 对角线，从右边向左下斜穿
          上边缘：(130,0) → (400,270)，斜率方向向量(270,270)=45°
          下边缘：(260,0) → (400,140)，同向，间距130px
          垂直宽度（绳带宽）：130 / √2 ≈ 92px，在1080px封面上视觉清晰
          两端自然隐入画面边缘，产生「穿过」效果
          丝带中心点：约 (295, 70)，文字对齐于此
        -->
        <polygon
          points="130,0 260,0 400,140 400,270"
          fill="url(#lrg)"
          filter="url(#lrs)"/>
        <!-- 织物高光边线（上缘） -->
        <line x1="130" y1="0" x2="400" y2="270" stroke="rgba(255,255,255,0.22)" stroke-width="2.5"/>
        <!-- 织物阴影边线（下缘） -->
        <line x1="260" y1="0" x2="400" y2="140" stroke="rgba(0,0,0,0.25)" stroke-width="2"/>
        <!-- 文字：沿丝带长轴方向(45°)，居于丝带中心 -->
        <text
          transform="translate(295, 103) rotate(45)"
          text-anchor="middle"
          dominant-baseline="middle"
          font-family="-apple-system, BlinkMacSystemFont, PingFang SC, STHeiti, Microsoft YaHei, sans-serif"
          font-size="52"
          font-weight="900"
          fill="{{ _rt }}"
          letter-spacing="5"
          style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));">{{ content_label }}</text>
      </svg>
    </div>
    {% endif %}

    <!-- 磨砂玻璃卡片 -->
    <div class="glass-card">
        <!-- 徽章药丸 -->
        <div class="badge-capsule">{{ badge }}</div>
        
        <!-- 核心内容 -->
        <div class="text-content-wrapper">
            <h1 class="main-title">{{ title }}</h1>
            {% if subtitle %}
            <div class="sub-title">{{ subtitle }}</div>
            {% endif %}
        </div>

        <!-- 隐喻矢量图标注入 (内联定位) -->
        {% if metaphor_svg %}
        <div class="metaphor-icon pos-{{ metaphor_placement }}">
            {{ metaphor_svg }}
        </div>
        {% endif %}
    </div>
</body>
</html>
