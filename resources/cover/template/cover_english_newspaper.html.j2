<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>English World Photographic Cover</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: {{ canvas_width }}px;
    height: {{ canvas_height }}px;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Source Han Serif CN", serif;
    position: relative;
    background: #FBF9F4;
  }

  /* 全幅真实摄影底图图层 */
  .editorial-visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('{{ visual_asset_url }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* 顶部徽章与打卡条 */
  .masthead {
    position: absolute;
    left: 48px;
    top: 44px;
    z-index: 10;
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .brand-badge {
    background: #A53C2B;
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 800;
    padding: 8px 22px;
    letter-spacing: 2px;
    border-radius: 4px;
    display: inline-block;
  }
  .masthead-meta {
    background: #142331;
    color: #F3E7CF;
    font-weight: 700;
    font-size: 22px;
    padding: 11px 18px;
    border-radius: 4px;
    display: inline-flex;
    gap: 12px;
  }

  /* 主标题区：采用高对比深色实底条，防止与复杂背景冲突并保证移动端高辨识度 */
  .title-section {
    position: absolute;
    left: 48px;
    top: 132px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .main-title {
    font-size: 84px;
    font-weight: 900;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    text-shadow: none;
    -webkit-text-stroke: 0;
  }
  .title-line {
    display: block;
    width: fit-content;
    white-space: nowrap;
    color: #FFFFFF;
    background: #142331;
    padding: 8px 24px 12px;
    margin-left: -24px;
    box-sizing: border-box;
    border-radius: 2px;
  }

  /* 底部半透收敛教学卡片面板 */
  .bottom-study-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    min-height: 360px;
    background: #FBF9F4;
    border-top: 6px solid #A53C2B;
    padding: 22px 48px 24px;
    box-shadow: 0 -12px 36px rgba(0, 0, 0, 0.18);
  }

  /* 英文原声精读引用 */
  .quote-container {
    margin-bottom: 14px;
  }
  .quote-label {
    font-size: 19px;
    font-weight: 800;
    color: #A53C2B;
    letter-spacing: 2px;
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .quote-en {
    font-family: "Baskerville", "Georgia", serif;
    font-size: 28px;
    line-height: 1.32;
    font-style: italic;
    color: #2D241E;
  }
  .quote-en .hl {
    background: #F8D6CD;
    color: #A53C2B;
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 700;
    font-style: normal;
  }
  .quote-zh {
    font-size: 22px;
    color: #5A4E44;
    line-height: 1.38;
    margin-top: 6px;
  }

  /* 核心生词卡栏 */
  .vocab-section {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    margin-bottom: 16px;
  }
  .vocab-item {
    flex: 1;
    background: #FFFFFF;
    border: 2px solid #E6DDD0;
    border-left: 6px solid #A87914;
    border-radius: 8px;
    padding: 10px 14px;
    min-width: 0;
  }
  .vocab-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .vocab-word {
    font-family: "Baskerville", serif;
    font-size: 26px;
    font-weight: 700;
    color: #1E1A18;
  }
  .vocab-ipa {
    font-size: 17px;
    color: #6E625A;
  }
  .vocab-def {
    font-size: 18px;
    color: #4A3E34;
    margin-top: 3px;
    line-height: 1.3;
  }
  .vocab-level {
    display: inline-block;
    font-size: 15px;
    background: #F1E9DA;
    color: #785A18;
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 700;
    margin-top: 3px;
  }

  /* 底部状态与版权条 */
  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #D8CFC4;
    padding-top: 10px;
    font-size: 18px;
    color: #8C7E72;
    font-weight: 600;
  }
  .footer-left {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #A53C2B;
    font-weight: 700;
  }
</style>
</head>
<body>
  {% if has_visual_asset %}
  <div class="editorial-visual"></div>
  {% endif %}

  <div class="masthead">
    <div class="brand-badge">{{ badge or "世界英语新闻精读" }}</div>
    <div class="masthead-meta">
      <span>{{ date_str or "今日外刊打卡" }}</span>
      <span>·</span>
      <span>{{ difficulty_tag or "★★★☆☆" }}</span>
    </div>
  </div>

  <div class="title-section">
    <h1 class="main-title">
      {% for line in title_lines %}
      <span class="title-line">{{ line }}</span>
      {% endfor %}
    </h1>
  </div>

  <div class="bottom-study-panel">
    {% if quote_en %}
    <div class="quote-container">
      <div class="quote-label">★ 精选原声金句 / KEY SENTENCE</div>
      <div class="quote-en">"{{ quote_en_html | safe }}"</div>
      {% if quote_zh %}
      <div class="quote-zh">{{ quote_zh }}</div>
      {% endif %}
    </div>
    {% endif %}

    {% if vocab_items %}
    <div class="vocab-section">
      {% for item in vocab_items[:2] %}
      <div class="vocab-item">
        <div class="vocab-header">
          <span class="vocab-word">{{ item.word }}</span>
          {% if item.ipa %}<span class="vocab-ipa">{% if item.phonetic_word and item.phonetic_word|lower != item.word|lower %}{{ item.phonetic_word }}: {% endif %}{{ item.ipa }}</span>{% endif %}
        </div>
        <div class="vocab-def">{{ item.meaning }}</div>
        <div class="vocab-level">{{ item.level or "外刊高频" }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="footer-bar">
      <div class="footer-left">
        <span>🎧 {{ audio_source or "原声精选" }}</span>
        <span>·</span>
        <span>逐词跟读</span>
        <span>·</span>
        <span>核心词汇</span>
      </div>
      <div class="footer-right">
        <span>{{ vocab_stat or "今日精读学习" }}</span>
      </div>
    </div>
  </div>
</body>
</html>
