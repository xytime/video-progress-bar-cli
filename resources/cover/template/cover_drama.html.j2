<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>Cover Render Template - Drama</title>
    <style>
        :root {
            --bg-start: {{ background_gradient_start }};
            --bg-end: {{ background_gradient_end }};
            --accent-color: {{ accent_color }};
            --accent-glow: {{ accent_glow }};
            --grid-color: {{ grid_color }};
            --noise-opacity: {{ noise_opacity }};
        }

        html, body {
            margin: 0;
            padding: 0;
            width: {{ canvas_width }}px;
            height: {{ canvas_height }}px;
            background: linear-gradient(175deg, var(--bg-start) 0%, var(--bg-end) 100%);
            font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "STHeiti", "Microsoft YaHei", sans-serif;
            overflow: hidden;
            position: relative;
            box-sizing: border-box;
        }

        .visual-layer {
            position: absolute;
            inset: 0;
            z-index: 0;
            background-image: url('{{ visual_asset_url }}');
            background-size: cover;
            background-position: center;
        }

        body.has-visual .orb-container,
        body.has-visual .grid-layer,
        body.has-visual .diagonal-bar {
            display: none;
        }

        /* 氛围发光球 */
        .orb-container {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
            pointer-events: none;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(160px);
            mix-blend-mode: screen;
            opacity: 0.85;
        }

        /* 点阵网格 */
        .grid-layer {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 2;
            background-image: radial-gradient(var(--grid-color) 2px, transparent 0);
            background-size: 60px 60px;
        }

        /* 对角线装饰色块 */
        .diagonal-bar {
            position: absolute;
            left: -10%;
            right: -10%;
            height: 6px;
            z-index: 3;
            opacity: 0.6;
        }

        .diagonal-bar-top {
            top: 22%;
            background: linear-gradient(90deg, transparent 0%, var(--accent-color) 40%, var(--accent-color) 60%, transparent 100%);
            transform: skewY(-2deg);
        }

        /* 大型数字/图标背景装饰（半透明）*/
        .bg-metaphor {
            position: absolute;
            bottom: 5%;
            right: -5%;
            width: 600px;
            height: 600px;
            z-index: 3;
            opacity: 0.08;
            color: var(--accent-color);
        }

        .bg-metaphor svg {
            width: 100%;
            height: 100%;
            stroke: currentColor;
            stroke-width: 1;
            fill: none;
        }

        /* 徽章 */
        .badge-capsule {
            position: absolute;
            top: 10%; /* [Gemini_3.5_Flash_planning] 还原 6:7 比例定位 */
            left: 8%;
            z-index: 10;
            background: var(--accent-color);
            color: #000000;
            padding: 14px 48px;
            border-radius: 8px;
            font-size: 40px;
            font-weight: 900;
            letter-spacing: 3px;
        }

        /* 主内容区 — 左对齐冲击感排版 */
        .content-area {
            position: absolute;
            bottom: 22%;
            left: 8%;
            right: 8%;
            z-index: 10;
        }

        /* 主标题 */
        .main-title {
            font-size: 108px;
            font-weight: 900;
            color: #ffffff;
            text-align: left;
            line-height: 1.25;
            letter-spacing: -1px;
            text-shadow: 0 0 60px rgba(0,0,0,0.8), 0 4px 20px rgba(0,0,0,0.5);
            -webkit-text-stroke: 4px rgba(3, 8, 13, 0.76);
            word-break: break-all;
            margin: 0 0 36px 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* 副标题 */
        .sub-title {
            font-size: 52px;
            font-weight: 400;
            color: var(--accent-color);
            text-align: left;
            line-height: 1.45;
            text-shadow: var(--accent-glow);
            -webkit-text-stroke: 2px rgba(3, 8, 13, 0.68);
            word-break: break-all;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            letter-spacing: 1px;
        }

        /* 前景隐喻图标 */
        .metaphor-icon {
            position: absolute;
            width: 130px;
            height: 130px;
            z-index: 15;
            opacity: 0.9;
            color: var(--accent-color);
            filter: drop-shadow(0 0 20px var(--accent-color));
        }

        .metaphor-icon svg {
            width: 100%;
            height: 100%;
            stroke: currentColor;
            stroke-width: 1.5;
            fill: none;
        }

        .pos-top-right {
            top: 8%; /* [Gemini_3.5_Flash_planning] 还原 6:7 比例定位 */
            right: 8%;
        }

        .pos-bottom-left {
            bottom: 8%; /* [Gemini_3.5_Flash_planning] 还原 6:7 比例定位 */
            left: 8%;
        }

    </style>
</head>
<body class="{% if visual_asset_url %}has-visual{% endif %}">
    {% if visual_asset_url %}
    <div class="visual-layer"></div>
    {% endif %}

    <!-- 点阵网格层 -->
    <div class="grid-layer"></div>

    <!-- 氛围光晕层 -->
    <div class="orb-container">
        {% for orb in orbs %}
        <div class="orb" style="
            left: {{ orb.cx_pct * 100 }}%;
            top: {{ orb.cy_pct * 100 }}%;
            width: {{ orb.radius_pct * 1080 * 2 }}px;
            height: {{ orb.radius_pct * 1080 * 2 }}px;
            transform: translate(-50%, -50%);
            background: radial-gradient(circle, rgba({{ orb.color_rgba[0] }}, {{ orb.color_rgba[1] }}, {{ orb.color_rgba[2] }}, {{ orb.color_rgba[3] / 255 }}) 0%, transparent 70%);
        "></div>
        {% endfor %}
    </div>

    <!-- [Gemini_2.5_Pro_planning] SVG丝带角标：右上角对角线织物丝带，精确几何路径 -->
    {% if content_label is defined and content_label %}
    {% if content_label in ['重磅', '突发', '警示'] %}
      {% set _rl = '#ef4444' %}{% set _rc = '#b91c1c' %}{% set _rd = '#7f1d1d' %}{% set _rt = '#ffffff' %}
    {% elif content_label in ['独家', '首发', '专访'] %}
      {% set _rl = '#fcd34d' %}{% set _rc = '#d97706' %}{% set _rd = '#78350f' %}{% set _rt = '#000000' %}
    {% elif content_label == '最新' %}
      {% set _rl = '#67e8f9' %}{% set _rc = '#0891b2' %}{% set _rd = '#164e63' %}{% set _rt = '#ffffff' %}
    {% elif content_label in ['深度', '解析', '完整版'] %}
      {% set _rl = '#c4b5fd' %}{% set _rc = '#7c3aed' %}{% set _rd = '#4c1d95' %}{% set _rt = '#ffffff' %}
    {% elif content_label == '揭秘' %}
      {% set _rl = '#fdba74' %}{% set _rc = '#ea580c' %}{% set _rd = '#7c2d12' %}{% set _rt = '#ffffff' %}
    {% elif content_label == '局势' %}
      {% set _rl = '#93c5fd' %}{% set _rc = '#1d4ed8' %}{% set _rd = '#1e3a8a' %}{% set _rt = '#ffffff' %}
    {% else %}
      {% set _rl = '#9ca3af' %}{% set _rc = '#374151' %}{% set _rd = '#111827' %}{% set _rt = '#ffffff' %}
    {% endif %}
    <!-- [Gemini_3.5_Flash_planning] 右上角丝带定位（6:7 封面下直接贴在 top:0 位置，不需要下移） -->
        {% set _rgb = "110, 68, 255" %}
    {% if content_label in ["重磅", "突发", "警示"] %}{% set _rgb = "239, 68, 68" %}
    {% elif content_label in ["独家", "首发", "专访"] %}{% set _rgb = "217, 119, 6" %}
    {% elif content_label == "最新" %}{% set _rgb = "8, 145, 178" %}
    {% elif content_label in ["深度", "解析", "完整版"] %}{% set _rgb = "124, 58, 237" %}
    {% elif content_label == "揭秘" %}{% set _rgb = "234, 88, 12" %}
    {% elif content_label == "局势" %}{% set _rgb = "29, 78, 216" %}
    {% else %}{% set _rgb = "156, 163, 175" %}{% endif %}
    
    <div style="position:absolute; top:90px; right:100px; z-index:30; pointer-events:none;
                display:flex; flex-direction:column; align-items:flex-end;">
      <!-- Horizontal indicator line with label -->
      <div style="display:flex; align-items:center; margin-bottom: 8px;">
        <!-- Small tech dot -->
        <span style="width: 8px; height: 8px; background-color: {{ _rl }}; margin-right: 10px; border-radius: 50%; box-shadow: 0 0 8px {{ _rl }};"></span>
        <!-- Small sub text -->
        <span style="font-family: monospace; font-size: 16px; color: {{ _rl }}; letter-spacing: 2px; font-weight: bold; text-transform: uppercase;">
          SYS_ALERT // {{ content_label }}
        </span>
      </div>
      <!-- Main label box -->
      <div style="background: linear-gradient(135deg, rgba({{ _rgb }}, 0.15) 0%, rgba({{ _rgb }}, 0.03) 100%);
                  border: 1px solid rgba({{ _rgb }}, 0.3);
                  border-right: 6px solid {{ _rl }};
                  border-radius: 4px;
                  padding: 12px 24px;
                  height: 48px;
                  box-shadow: -5px 5px 25px rgba(0,0,0,0.5);
                  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
                  display: flex; align-items: center; justify-content: center;">
        <span style="font-family: -apple-system, BlinkMacSystemFont, PingFang SC, sans-serif;
                     font-size: 36px; font-weight: 900; color: #ffffff; letter-spacing: 6px; line-height: 1;
                     text-shadow: 0 0 10px rgba({{ _rgb }}, 0.8);">
          {{ content_label }}
        </span>
      </div>
      <!-- Corner bracket line accents -->
      <div style="width: 180px; height: 2px; background: linear-gradient(to left, transparent, {{ _rl }}); margin-top: 6px; opacity: 0.8;"></div>
    </div>
    {% endif %}

    <!-- 对角线装饰条 -->
    <div class="diagonal-bar diagonal-bar-top"></div>

    <!-- 大型背景隐喻（半透明装饰）-->
    {% if show_metaphor and metaphor_svg %}
    <div class="bg-metaphor">
        {{ metaphor_svg }}
    </div>
    {% endif %}

    <!-- 徽章 -->
    <div class="badge-capsule">{{ badge }}</div>

    <!-- 核心文字区 -->
    <div class="content-area">
        <h1 class="main-title">{{ title }}</h1>
        {% if subtitle %}
        <div class="sub-title">{{ subtitle }}</div>
        {% endif %}
    </div>

    <!-- 前景图标（小） -->
    {% if show_metaphor and metaphor_svg %}
    <div class="metaphor-icon pos-{{ metaphor_placement }}">
        {{ metaphor_svg }}
    </div>
    {% endif %}
</body>
</html>
